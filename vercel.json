{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "installCommand": "bun install",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/community",
      "destination": "https://statusline-community.zoniixyt.workers.dev/ssr/community"
    },
    { "source": "/builder", "destination": "/builder.html" },
    {
      "source": "/how-to-make-a-claude-code-statusline",
      "destination": "/how-to-make-a-claude-code-statusline.html"
    },
    {
      "source": "/best-claude-code-statusline",
      "destination": "/best-claude-code-statusline.html"
    },
    {
      "source": "/claude-code-statusline-git-branch",
      "destination": "/claude-code-statusline-git-branch.html"
    },
    {
      "source": "/claude-code-statusline-token-usage",
      "destination": "/claude-code-statusline-token-usage.html"
    },
    {
      "source": "/claude-code-statusline-cost",
      "destination": "/claude-code-statusline-cost.html"
    },
    {
      "source": "/claude-code-statusline-model",
      "destination": "/claude-code-statusline-model.html"
    },
    {
      "source": "/claude-code-statusline-duration",
      "destination": "/claude-code-statusline-duration.html"
    },
    {
      "source": "/claude-code-statusline-rate-limit",
      "destination": "/claude-code-statusline-rate-limit.html"
    },
    {
      "source": "/claude-code-statusline-directory",
      "destination": "/claude-code-statusline-directory.html"
    },
    {
      "source": "/claude-code-statusline-lines-changed",
      "destination": "/claude-code-statusline-lines-changed.html"
    },
    {
      "source": "/claude-code-statusline-context-window",
      "destination": "/claude-code-statusline-context-window.html"
    },
    {
      "source": "/claude-code-statusline-output-style",
      "destination": "/claude-code-statusline-output-style.html"
    },
    {
      "source": "/claude-code-statusline-thinking-effort",
      "destination": "/claude-code-statusline-thinking-effort.html"
    },
    {
      "source": "/claude-code-statusline-nerd-font",
      "destination": "/claude-code-statusline-nerd-font.html"
    },
    {
      "source": "/claude-code-statusline-powerline",
      "destination": "/claude-code-statusline-powerline.html"
    },
    {
      "source": "/claude-code-statusline-windows",
      "destination": "/claude-code-statusline-windows.html"
    },
    {
      "source": "/claude-code-statusline-vs-ccstatusline",
      "destination": "/claude-code-statusline-vs-ccstatusline.html"
    },
    {
      "source": "/claude-code-statusline-not-showing",
      "destination": "/claude-code-statusline-not-showing.html"
    },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    {
      "source": "/sitemap-community.xml",
      "destination": "https://statusline-community.zoniixyt.workers.dev/sitemap.xml"
    },
    {
      "source": "/community/:slug",
      "destination": "https://statusline-community.zoniixyt.workers.dev/ssr/community/:slug"
    },
    { "source": "/((?!_next|assets|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
